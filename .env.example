# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@jobboost.ai

# Stripe — 4 plans
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_BASIC=price_basic_id         # 29,99€/mois
STRIPE_PRICE_PREMIUM=price_premium_id     # 39,99€/mois
STRIPE_PRICE_LIFETIME=price_lifetime_id   # 99,99€ one-time
# Legacy alias (maps to STRIPE_PRICE_BASIC)
STRIPE_PRICE_MONTHLY=price_basic_id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
